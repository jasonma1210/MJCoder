const { app, BrowserWindow, ipcMain, shell } = require('electron');
const path = require('path');
const { exec, spawn } = require('child_process');
const fsp = require('fs/promises');
const fs = require('fs');
const os = require('os');

let mainWindow;

// ═══════════════════════════════════════════
//  MODEL SECRETS（仅主进程持有，严禁流向渲染层）
// ═══════════════════════════════════════════
const MJ_SERVER = process.env.MJ_SERVER_API || 'http://localhost:3001/api';
const secrets = new Map(); // `${isGlobal ? 'g' : 'u'}:${id}` -> { api_key, base_url }
const activeChats = new Set(); // 进行中的 chat AbortController

ipcMain.handle('model:getSecrets', async (_, { token }) => {
  if (!token) return { ok: false, error: 'NO_TOKEN' };
  const headers = { Authorization: `Bearer ${token}` };
  let count = 0;
  try {
    const [userRes, globalRes] = await Promise.all([
      fetch(`${MJ_SERVER}/providers/secrets`, { headers }),
      fetch(`${MJ_SERVER}/global/providers/secrets`, { headers }),
    ]);
    if (userRes.ok) {
      for (const p of await userRes.json()) {
        secrets.set(`u:${p.id}`, { api_key: p.api_key, base_url: p.base_url });
        count++;
      }
    } else {
      console.warn('[secrets] 私有凭证拉取失败:', userRes.status);
    }
    if (globalRes.ok) {
      for (const p of await globalRes.json()) {
        secrets.set(`g:${p.id}`, { api_key: p.api_key, base_url: p.base_url });
        count++;
      }
    } else {
      console.warn('[secrets] 全局凭证拉取失败:', globalRes.status);
    }
    return { ok: true, count };
  } catch (err) {
    console.error('[secrets] 拉取异常:', err);
    return { ok: false, error: err.message };
  }
});

const WINDOW_STATE_FILE = () => path.join(app.getPath('userData'), 'window-state.json');

function loadWindowState() {
  try {
    return JSON.parse(fs.readFileSync(WINDOW_STATE_FILE(), 'utf8'));
  } catch (e) {
    return null; // 首次启动或文件损坏时回落默认值
  }
}

function saveWindowState() {
  if (!mainWindow) return;
  try {
    fs.writeFileSync(WINDOW_STATE_FILE(), JSON.stringify(mainWindow.getBounds()));
  } catch (e) {
    console.warn('[window] 状态保存失败:', e.message);
  }
}

function createWindow() {
  const state = loadWindowState();
  mainWindow = new BrowserWindow({
    width: state?.width || 1600,
    height: state?.height || 1000,
    x: state?.x,
    y: state?.y,
    minWidth: 1200, minHeight: 700,
    title: 'MJ Coder', backgroundColor: '#0d0d0d', titleBarStyle: 'hiddenInset',
    webPreferences: { preload: path.join(__dirname, 'preload.js'), nodeIntegration: false, contextIsolation: true },
  });
  // 生产构建走 file:// 加载打包产物；开发走 vite dev server
  if (app.isPackaged) {
    mainWindow.loadFile(path.join(__dirname, '../renderer/dist/index.html'));
  } else {
    mainWindow.loadURL('http://localhost:5173');
    if (process.env.NODE_ENV === 'development') mainWindow.webContents.openDevTools();
  }
  mainWindow.webContents.setWindowOpenHandler(({ url }) => { shell.openExternal(url); return { action: 'deny' }; });
  mainWindow.on('close', saveWindowState);
}

// 单实例锁：第二个实例启动时聚焦已有窗口
if (!app.requestSingleInstanceLock()) {
  app.quit();
} else {
  app.on('second-instance', () => {
    if (!mainWindow) return;
    if (mainWindow.isMinimized()) mainWindow.restore();
    mainWindow.focus();
  });
  app.whenReady().then(createWindow);
}

app.on('window-all-closed', () => { if (process.platform !== 'darwin') app.quit(); });
app.on('activate', () => { if (BrowserWindow.getAllWindows().length === 0) createWindow(); });

// ═══════════════════════════════════════════
//  AGENT TOOL EXECUTION LAYER
// ═══════════════════════════════════════════

// 危险命令审批
const DANGEROUS_PATTERNS = [
  /\brm\s+-[rf]/, /\bsudo\b/, /\bgit\s+push\b/, /\bgit\s+reset\s+--hard\b/,
  /\bchmod\s+777\b/, /\bmkfs\b/, /\bdd\s+if=/, /:\(\}\)/, /\bshutdown\b/, /\breboot\b/,
];

ipcMain.handle('tool:shell', async (_, { command, cwd, timeout = 60000, requireApproval = true }) => {
  // 危险命令需要审批
  if (requireApproval && DANGEROUS_PATTERNS.some(p => p.test(command))) {
    const approved = await new Promise((resolve) => {
      mainWindow.webContents.send('tool:approval-request', { tool: 'shell', command });
      ipcMain.once('tool:approval-response', (_, approved) => resolve(approved));
      setTimeout(() => resolve(false), 120000);
    });
    if (!approved) return { stdout: '', stderr: '用户拒绝执行', exitCode: -1, error: 'Approval denied' };
  }
  return new Promise((resolve) => {
    exec(command, { cwd: cwd || process.cwd(), timeout, maxBuffer: 5 * 1024 * 1024 }, (error, stdout, stderr) => {
      resolve({ stdout: stdout.slice(0, 50000), stderr: stderr.slice(0, 10000), exitCode: error?.code || 0, error: error?.message || null });
    });
  });
});

ipcMain.handle('tool:readFile', async (_, { path: p, offset, limit }) => {
  const content = await fsp.readFile(p, 'utf8');
  const lines = content.split('\n');
  if (offset !== undefined && limit !== undefined) return { path: p, content: lines.slice(offset, offset + limit).join('\n'), totalLines: lines.length };
  return { path: p, content, totalLines: lines.length };
});

ipcMain.handle('tool:writeFile', async (_, { path: p, content }) => {
  await fsp.mkdir(path.dirname(p), { recursive: true });
  await fsp.writeFile(p, content, 'utf8');
  return { ok: true, path: p };
});

ipcMain.handle('tool:editFile', async (_, { path: p, search, replace }) => {
  let content = await fsp.readFile(p, 'utf8');
  if (!content.includes(search)) throw new Error('未找到要替换的内容');
  content = content.replace(search, replace);
  await fsp.writeFile(p, content, 'utf8');
  return { ok: true, path: p };
});

// apply_patch - 统一 diff 格式补丁
ipcMain.handle('tool:applyPatch', async (_, { patch }) => {
  const tmp = path.join(os.tmpdir(), `mjcoder-${Date.now()}.patch`);
  await fsp.writeFile(tmp, patch, 'utf8');
  return new Promise((resolve) => {
    exec(`patch -p1 < ${tmp}`, { cwd: process.cwd() }, (error, stdout, stderr) => {
      fsp.unlink(tmp).catch(() => {});
      resolve({ stdout: stdout.slice(0, 10000), stderr: stderr.slice(0, 5000), error: error?.message || null });
    });
  });
});

ipcMain.handle('tool:listDir', async (_, { path: p }) => {
  const entries = await fsp.readdir(p || '.', { withFileTypes: true });
  return entries.filter(e => !e.name.startsWith('.') || true).map(e => ({ name: e.name, isDir: e.isDirectory(), type: e.isDirectory() ? 'dir' : 'file' }));
});

ipcMain.handle('tool:grep', async (_, { pattern, path: p, glob }) => {
  return new Promise((resolve) => {
    exec(`grep -rn --include="${glob || '*.*'}" "${pattern}" "${p || '.'}" | head -200`, { timeout: 15000 }, (error, stdout) => {
      resolve({ matches: stdout.slice(0, 20000) });
    });
  });
});

ipcMain.handle('tool:glob', async (_, { pattern, path: p }) => {
  return new Promise((resolve) => {
    exec(`find "${p || '.'}" -name '${pattern}' -type f -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | head -100`, (error, stdout) => {
      resolve({ files: stdout.trim().split('\n').filter(Boolean) });
    });
  });
});

// ── Git 工具 ──
ipcMain.handle('tool:gitStatus', async (_, { cwd }) => runGit('status --short', cwd));
ipcMain.handle('tool:gitDiff', async (_, { cwd, staged }) => runGit(`diff ${staged ? '--staged' : ''}`, cwd));
ipcMain.handle('tool:gitLog', async (_, { cwd, count = 10 }) => runGit(`log --oneline -${count}`, cwd));
ipcMain.handle('tool:gitBranch', async (_, { cwd }) => runGit('branch -a', cwd));
ipcMain.handle('tool:gitCommit', async (_, { cwd, message }) => runGit(`commit -m "${message.replace(/"/g, '\\"')}"`, cwd));
ipcMain.handle('tool:gitAdd', async (_, { cwd, files = '.' }) => runGit(`add ${files}`, cwd));

function runGit(args, cwd) {
  return new Promise((resolve) => {
    exec(`git ${args}`, { cwd: cwd || process.cwd() }, (error, stdout, stderr) => {
      resolve({ stdout: stdout.slice(0, 30000), stderr: stderr.slice(0, 5000), error: error?.message || null });
    });
  });
}

// ── MCP 客户端（stdio JSON-RPC）──
const mcpServers = new Map(); // name -> { child, pending, nextId, tools, stderrTail }

// 单次 JSON-RPC 请求：id 关联 + 超时清理，杜绝 initialize 提前 resolve 吞掉 tools/list
function mcpRpc(server, method, params, timeoutMs = 30000) {
  return new Promise((resolve, reject) => {
    const id = server.nextId++;
    const timer = setTimeout(() => {
      server.pending.delete(id);
      reject(new Error(`MCP ${method} 超时（${timeoutMs / 1000}s）`));
    }, timeoutMs);
    server.pending.set(id, (msg) => {
      clearTimeout(timer);
      if (msg.error) reject(new Error(msg.error.message || 'MCP 返回错误'));
      else resolve(msg.result);
    });
    server.child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params: params || {} }) + '\n');
  });
}

ipcMain.handle('mcp:connect', async (_, { name, command, args = [], env = {} }) => {
  if (mcpServers.has(name)) {
    const cached = mcpServers.get(name);
    return { ok: true, server: name, toolCount: cached.tools.length, tools: cached.tools, cached: true };
  }
  if (!name || !command) return { ok: false, error: 'name 与 command 必填' };
  const child = spawn(command, args, {
    stdio: ['pipe', 'pipe', 'pipe'],
    env: { ...process.env, ...env },
  });
  const server = { child, pending: new Map(), nextId: 1, tools: [], stderrTail: '' };
  let buf = '';

  child.stdout.on('data', (data) => {
    buf += data.toString();
    const lines = buf.split('\n');
    buf = lines.pop();
    for (const line of lines) {
      if (!line.trim()) continue;
      try {
        const msg = JSON.parse(line);
        if (msg.id !== undefined && server.pending.has(msg.id)) {
          server.pending.get(msg.id)(msg);
          server.pending.delete(msg.id);
        }
      } catch (e) {
        console.warn(`[MCP ${name}] 非 JSON 输出:`, line.slice(0, 120));
      }
    }
  });
  child.stderr.on('data', (d) => {
    server.stderrTail = (server.stderrTail + d.toString()).slice(-2000);
    console.log(`[MCP ${name}]`, d.toString().trim());
  });
  child.on('close', (code) => { mcpServers.delete(name); console.log(`[MCP ${name}] 进程退出 code=${code}`); });
  child.on('error', (err) => { mcpServers.delete(name); console.error(`[MCP ${name}] 启动失败:`, err.message); });

  mcpServers.set(name, server);
  try {
    // 1. initialize → 2. notifications/initialized → 3. tools/list（三步分离，各自超时）
    await mcpRpc(server, 'initialize', {
      protocolVersion: '2024-11-05',
      capabilities: {},
      clientInfo: { name: 'mj-coder', version: '1.0' },
    });
    child.stdin.write(JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized' }) + '\n');
    const listRes = await mcpRpc(server, 'tools/list', {});
    server.tools = listRes?.tools || [];
    return { ok: true, server: name, toolCount: server.tools.length, tools: server.tools };
  } catch (err) {
    child.kill();
    mcpServers.delete(name);
    return { ok: false, error: err.message, stderr: server.stderrTail };
  }
});

ipcMain.handle('mcp:callTool', async (_, { server, tool, arguments: args }) => {
  const s = mcpServers.get(server);
  if (!s) throw new Error(`MCP 服务 ${server} 未连接`);
  try {
    return await mcpRpc(s, 'tools/call', { name: tool, arguments: args || {} });
  } catch (err) {
    return { error: err.message };
  }
});

ipcMain.handle('mcp:disconnect', async (_, { name }) => {
  const s = mcpServers.get(name);
  if (s) { s.child.kill(); mcpServers.delete(name); }
  return { ok: true };
});

ipcMain.handle('mcp:listServers', async () => {
  return Array.from(mcpServers.entries()).map(([name, s]) => ({ name, toolCount: s.tools.length }));
});

// ═══════════════════════════════════════════
//  MODEL PROXY (streaming, main-process direct)
// ═══════════════════════════════════════════
ipcMain.handle('model:chat', async (event, { providerId, isGlobal = false, baseUrl, messages, model, tools }) => {
  const secret = secrets.get(`${isGlobal ? 'g' : 'u'}:${providerId}`);
  if (!secret || !secret.api_key) {
    throw new Error('KEY_MISSING: 模型凭证未加载，请重新登录后重试');
  }
  const root = (baseUrl || secret.base_url || '').replace(/\/+$/, '');
  if (!root) throw new Error('BASE_URL_MISSING: 模型服务地址为空');
  const body = { model, messages, stream: true, stream_options: { include_usage: true } };
  if (tools) body.tools = tools;

  let fullContent = '';
  let usage = null;
  const controller = new AbortController();
  activeChats.add(controller);
  try {
    const res = await fetch(`${root}/chat/completions`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${secret.api_key}` },
      body: JSON.stringify(body),
      signal: controller.signal,
    });

    if (!res.ok) {
      const err = await res.text();
      throw new Error(`API ${res.status}: ${err.slice(0, 500)}`);
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    let toolCalls = [];

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop();
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        const data = line.slice(6).trim();
        if (data === '[DONE]') continue;
        try {
          const json = JSON.parse(data);
          const delta = json.choices?.[0]?.delta;
          if (delta?.content) {
            fullContent += delta.content;
            event.sender.send('model:delta', delta.content);
          }
          if (delta?.tool_calls) {
            for (const tc of delta.tool_calls) {
              const idx = tc.index || 0;
              if (!toolCalls[idx]) toolCalls[idx] = { id: tc.id, type: 'function', function: { name: tc.function?.name || '', arguments: '' } };
              if (tc.function?.name) toolCalls[idx].function.name = tc.function.name;
              if (tc.function?.arguments) toolCalls[idx].function.arguments += tc.function.arguments;
            }
          }
          if (json.usage) usage = json.usage;
        } catch (e) {
          console.warn('[model] SSE 分片解析失败:', e.message);
        }
      }
    }
    return { content: fullContent, tool_calls: toolCalls.filter(Boolean), usage };
  } catch (err) {
    if (err.name === 'AbortError') {
      return { aborted: true, content: fullContent, usage };
    }
    throw err;
  } finally {
    activeChats.delete(controller);
  }
});

// 中止全部进行中的 chat（停止生成）
ipcMain.handle('model:abort', async () => {
  const n = activeChats.size;
  for (const c of activeChats) c.abort();
  activeChats.clear();
  return { ok: true, aborted: n };
});
