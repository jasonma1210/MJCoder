import { useState, useEffect } from 'react';
import { IconAlert, IconFile, IconPlug, IconTerminal } from './icons';

const LEVEL_META = {
  L1: { label: '危险命令', Icon: IconTerminal, color: 'text-danger' },
  L2: { label: '文件写入', Icon: IconFile, color: 'text-warn' },
  L3: { label: 'MCP 工具', Icon: IconPlug, color: 'text-info' },
};

export default function ApprovalDialog() {
  const [pending, setPending] = useState(null);

  useEffect(() => {
    if (!window.mjcode?.onApprovalRequest) return;
    const off = window.mjcode.onApprovalRequest((req) => setPending(req));
    return () => { if (typeof off === 'function') off(); };
  }, []);

  if (!pending) return null;
  const meta = LEVEL_META[pending.level] || LEVEL_META.L2;

  function resolve(decision) {
    window.mjcode.resolveApproval(decision);
    setPending(null);
  }

  return (
    <div className="fixed inset-0 bg-overlay flex items-center justify-center z-approval">
      <div className="bg-surface border border-border rounded-2xl p-6 w-[560px]">
        <h3 className="text-base font-semibold mb-2 flex items-center gap-2">
          <span className={meta.color}><meta.Icon size={16} /></span>
          {meta.label}确认
          <span className="text-text2 text-xs font-normal ml-1">{pending.tool}</span>
        </h3>
        <p className="text-sm text-text2 mb-3">MJ Coder 想要执行以下操作，请确认：</p>
        <pre className="bg-surface p-3 rounded-lg text-xs font-mono overflow-x-auto max-h-48 mb-5 whitespace-pre-wrap">{pending.detail || '（无详情）'}</pre>
        <div className="flex flex-wrap justify-end gap-2">
          <button onClick={() => resolve('deny')}
            className="px-4 py-2 rounded-lg text-sm border border-border hover:bg-hover">拒绝</button>
          <button onClick={() => resolve('once')}
            className="px-4 py-2 rounded-lg text-sm border border-border hover:bg-hover">允许一次</button>
          <button onClick={() => resolve('conversation')}
            className="px-4 py-2 rounded-lg text-sm border border-border hover:bg-hover">本对话同类允许</button>
          <button onClick={() => resolve('always')}
            className="px-4 py-2 rounded-lg text-sm bg-accent text-white hover:opacity-90">始终允许</button>
        </div>
      </div>
    </div>
  );
}
