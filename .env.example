# 服务端端口
PORT=3001

# PostgreSQL 连接串
DATABASE_URL=postgresql://jianma@localhost:5432/mjcode

# JWT 签名密钥（生产必须轮换；生成：openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d

# API Key 落库加密密钥（32 字节 hex；生成：openssl rand -hex 32）
# 不设置时服务端将明文存储并每次启动警告一次
ENCRYPTION_KEY=

# 管理员邮箱（逗号分隔；注册时匹配的邮箱自动获得 admin 角色）
ADMIN_EMAILS=
