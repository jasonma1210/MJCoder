page {
  background: #0d0d0d;
  color: #e8e8e8;
  font-size: 28rpx;
}
.card {
  background: #1e1e1e;
  border: 1rpx solid #2a2a2a;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
}
.muted {
  color: #888;
  font-size: 24rpx;
}
.btn-primary {
  background: #10a37f;
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.btn-danger {
  background: #b91c1c;
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.status-success { color: #22c55e; }
.status-failed { color: #ef4444; }
.status-running { color: #10a37f; }
.status-review { color: #f59e0b; }
